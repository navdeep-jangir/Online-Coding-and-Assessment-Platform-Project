# CodeClimb Environment Variables
# Copy this file to .env in the server directory

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/codeclimb

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Judge0 Code Execution
# Public Judge0 CE development endpoint (or self-hosted http://localhost:2358)
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
# For RapidAPI hosted Judge0, use:
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your-rapidapi-key
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Admin Setup (used by seed / provision:admin script)
ADMIN_EMAIL=admin@codeclimb.dev
ADMIN_PASSWORD=<set-strong-admin-password>

# Demo Account (development only)
DEMO_EMAIL=demo@codeclimb.dev
DEMO_PASSWORD=<set-dev-only-demo-password>

# Timezone
TZ=Asia/Kolkata