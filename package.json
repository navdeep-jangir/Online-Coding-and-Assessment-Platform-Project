{
  "name": "codeclimb",
  "version": "1.0.0",
  "private": true,
  "description": "CodeClimb - Learn. Practice. Climb. Online Coding and DSA Assessment Platform.",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "seed": "cd server && npm run seed",
    "seed:curriculum": "cd server && npm run seed:curriculum",
    "seed:problems": "cd server && npm run seed:problems",
    "seed:demo": "cd server && npm run seed:demo",
    "test": "npm run test:server && npm run test:client",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test",
    "test:e2e": "cd client && npx playwright test",
    "lint": "cd client && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}